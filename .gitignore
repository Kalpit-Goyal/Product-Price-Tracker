# Dependencies
node_modules/

# Build output
dist/
build/
.vercel/

# Secrets. The .env.example files ARE committed on purpose: they document the
# contract. The real files never are.
.env
.env.local
.env.*.local
*.pem

# Local development database. This holds real tracked products and observations on
# this machine; it is not source and must not be published.
.data/
*.memory-db.json
memory-db.json

# Generated by scripts/verify-ui.mjs
ui-shots/

# Throwaway probe output from the diagnostic scripts in backend/scripts/
*.txt
!backend/**/*.md

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# The assignment brief arrived as a PDF. It is not source and just adds weight to the
# repo, so it is ignored. The markdown copy of the brief is ignored separately below.
*.pdf

# Playwright / test artefacts
test-results/
playwright-report/
.playwright/
.env.bak-*

# Working notes, kept on disk but not published. README.md and DESIGN_NOTE.md are the
# two documents that are meant to be read, so they stay tracked; these are the private
# scratch docs behind them. Listed by path rather than as *.md, so a new document is
# tracked by default instead of silently disappearing.
/BUILD_LOG.md
/DEPLOYMENT.md
/REQUIREMENTS.md
/TECH_STACK.md
/frontend/vercel.md
