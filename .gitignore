# Dependencies
node_modules/

# Build output
dist/
build/
.vercel/

# Secrets. The .env.example files ARE committed on purpose: they document the
# contract. The real files never are.
.env
.env.local
.env.*.local
*.pem

# Local development database. This holds real tracked products and observations on
# this machine; it is not source and must not be published.
.data/
*.memory-db.json
memory-db.json

# Generated by scripts/verify-ui.mjs
ui-shots/

# Throwaway probe output from the diagnostic scripts in backend/scripts/
*.txt
!backend/**/*.md

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# The assignment brief itself. REQUIREMENTS.md captures what matters; the PDF is not
# source and just adds weight to the repo.
*.pdf

# Playwright / test artefacts
test-results/
playwright-report/
.playwright/
.env.bak-*
