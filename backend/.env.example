# --- backend env for local development ---
# Copy to .env and fill in. NEVER commit the real .env.

PORT=10000
NODE_ENV=development

# Supabase — server-side only. The service-role key bypasses RLS; never expose it
# to the browser and never prefix it with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret that authenticates POST /api/scrape/run from cron-job.org
CRON_SECRET=replace-with-at-least-32-random-characters

# 1 = headless (production) / 0 = headed (local screen recording)
HEADLESS=1
# Milliseconds of artificial delay per interaction step. Headed only.
SLOWMO_MS=0

# The ONLY host permitted to be scraped. The app refuses to boot otherwise.
SCRAPE_BASE_URL=https://demo.inelabteamdev.com

SCRAPE_TIMEOUT_MS=30000
SCRAPE_MAX_ATTEMPTS=6
SCRAPE_CONCURRENCY=1
SCRAPE_USER_AGENT=ine-price-tracker/1.0 (+assignment; contact: you@example.com)

ALLOWED_ORIGIN=*
LOG_LEVEL=info

# Run-scoped keep-alive. Off locally; Render sets these to 1 / 60000.
# This only heartbeats our own /api/health WHILE a scrape is running. It never
# schedules scrapes, so the external cron is still the only trigger.
# Leave KEEP_ALIVE_URL unset locally. In a deployed environment it MUST be the
# PUBLIC url, because a self-request to 127.0.0.1 is not traffic the host sees
# arriving and would therefore not prevent an idle spin-down.
KEEP_ALIVE_DURING_RUNS=0
KEEP_ALIVE_INTERVAL_MS=60000
# KEEP_ALIVE_URL=https://your-service.onrender.com

# --- local development only: neither of these is set on Render ---

# cron-job.org API key. LOCAL OPERATOR CREDENTIAL ONLY.
# This authenticates US to cron-job.org so the 2-hourly job can be created and edited
# programmatically. It is NOT the value sent in the X-Cron-Secret header -- that is
# CRON_SECRET above, and the two authenticate in opposite directions. Never set this on
# Render, and never commit it.
# CRONJOB_API_KEY=your-cron-job-org-api-key

# 1 shows a "run the scraper now" button in the local dashboard and lets
# /api/scrape/run accept a request with no secret, so you don't have to paste a
# secret into devtools. It is deliberately inert in production: the check is
# `NODE_ENV !== 'production' && ALLOW_DEV_TRIGGER === '1'`, and Render sets
# NODE_ENV=production, so a browser can never trigger a scrape on the deployed API.
# Leave this UNSET in production. See backend/src/app.js for the endpoint.
# ALLOW_DEV_TRIGGER=1

# When 1, use a local JSON file instead of Supabase. Handy for isolating a scraper
# bug from a database bug, and for running the smoke tests against seeded data. The
# app refuses to boot with this on when NODE_ENV=production, so it cannot be the
# reason a deployed instance silently serves stale local data.
# MEMORY_DB=1
# MEMORY_DB_FILE=.data/memory-db.json
