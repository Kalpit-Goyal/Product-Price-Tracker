# Base URL of the backend API.
#
# In development this can be left empty: vite.config.js proxies /api to
# http://127.0.0.1:10000, so the browser sees a single origin. That port has to
# match the backend's PORT -- the server's default. BACKEND_URL overrides it if
# the two ever need to differ.
#
# In production it MUST be set to the deployed Render URL, e.g.
#   https://ine-price-tracker.onrender.com
# There is no proxy in front of a public Vercel page, so the frontend has to know
# the absolute backend address.
VITE_API_BASE_URL=

# Note: nothing secret belongs in this file. Vite inlines VITE_* variables into the
# public JS bundle, so a VITE_ variable is visible to every visitor. The Supabase
# service-role key and the cron secret stay in the backend's environment.
